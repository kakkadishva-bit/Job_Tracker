+  else sp.forEach(function(s){var p=data.skill_progress[s];html+='<div style="margin-bottom:12px"><div style="display:flex;justify-content:space-between;font-size:0.9rem;margin-bottom:4px"><span>'+s+'</span><span>'+p+'%</span></div><div class="progress-bar"><div class="progress-fill" style="width:'+p+'%"></div></div></div>';});
+  html+='</div>';
+  grid.innerHTML=html;
