+  html+='</div>';
+
+  html+='<div class="dashboard-section"><h3><i class="fas fa-search"></i> Search History</h3>';
+  if(!data.search_history.length)html+='<div class="empty-state"><i class="fas fa-search"></i><p>No searches yet</p></div>';
+  else data.search_history.slice(-10).reverse().forEach(function(s){
+    html+='<div class="dashboard-job-item"><div class="dashboard-job-info"><div class="dashboard-job-title">'+s.query+'</div><div class="dashboard-job-company">'+s.date+'</div></div></div>';
+  });
+  html+='</div>';
+
+  html+='<div class="dashboard-section"><h3><i class="fas fa-lightbulb"></i> Skill Progress</h3>';
